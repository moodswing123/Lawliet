DATABASE_URL="postgresql://user:password@host:5432/lawliet_chat?schema=public"
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="https://your-vercel-domain.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"

# Gmail SMTP sender (use a Google app password, never the normal account password)
GMAIL_USER="support.lawlietgpt@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-google-app-password"
# Active AI provider
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.7

RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
NEXT_PUBLIC_APP_NAME="Lawliet"
